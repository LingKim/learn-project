# Existing local PostgreSQL container
POSTGRES_CONTAINER_NAME=myPostGres
POSTGRES_ADMIN_USER=postgres
APP_DB_NAME=xuemian_ai
APP_DB_USER=xuemian_ai_app
APP_DB_PASSWORD=replace-with-generated-local-secret
DATABASE_URL=postgresql+asyncpg://xuemian_ai_app:replace-with-generated-local-secret@localhost:5432/xuemian_ai

# Existing local Redis container
REDIS_CONTAINER_NAME=myRedis
REDIS_URL=redis://localhost:6379/0

# RustFS managed by this project
RUSTFS_ACCESS_KEY=replace-with-generated-local-access-key
RUSTFS_SECRET_KEY=replace-with-generated-local-secret-key
RUSTFS_HEALTH_URL=http://localhost:9000/health

# Application
ENVIRONMENT=development
LOG_FORMAT=console
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=2
BACKEND_INTERNAL_URL=http://backend:8000
