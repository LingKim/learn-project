# Existing local PostgreSQL container
POSTGRES_CONTAINER_NAME=myPostGres
POSTGRES_ADMIN_USER=postgres
APP_DB_NAME=xuemian_ai
APP_DB_USER=xuemian_ai_app
APP_DB_PASSWORD=replace-with-generated-local-secret
DATABASE_URL=postgresql+asyncpg://xuemian_ai_app:replace-with-generated-local-secret@localhost:5432/xuemian_ai

# Existing local Redis container
REDIS_CONTAINER_NAME=myRedis
REDIS_URL=redis://localhost:6379/0

# RustFS managed by this project
RUSTFS_ACCESS_KEY=replace-with-generated-local-access-key
RUSTFS_SECRET_KEY=replace-with-generated-local-secret-key
RUSTFS_HEALTH_URL=http://localhost:9000/health
RUSTFS_INTERNAL_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_QUARANTINE_BUCKET=xuemian-quarantine
RUSTFS_DOCUMENTS_BUCKET=xuemian-documents
RUSTFS_RECORDINGS_BUCKET=xuemian-recordings
RUSTFS_TEMPORARY_BUCKET=xuemian-temporary
FILE_UPLOAD_URL_SECONDS=900
FILE_DOWNLOAD_URL_SECONDS=300
FILE_UPLOAD_SESSION_HOURS=24
FILE_CONFIRMATION_MINUTES=5
FILE_WORKER_POLL_SECONDS=1
FILE_WORKER_LEASE_SECONDS=300
FILE_CLEANUP_BATCH_SIZE=100
FILE_TEMPORARY_RETENTION_DAYS=2

# Application
ENVIRONMENT=development
LOG_FORMAT=console
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=2
BACKEND_INTERNAL_URL=http://backend:8000

# Authentication (scripts/init-env.sh replaces these local placeholders)
AUTH_ACCESS_SECRET=replace-with-generated-access-secret
AUTH_REFRESH_SECRET=replace-with-generated-refresh-secret
AUTH_REFRESH_DIGEST_SECRET=replace-with-generated-refresh-digest-secret
AUTH_FINGERPRINT_SECRET=replace-with-generated-fingerprint-secret
AUTH_ISSUER=xuemian-ai
AUTH_AUDIENCE=xuemian-ai-web
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REDIS_KEY_PREFIX=xuemian:development:auth

# Optional explicit administrator bootstrap input; never use defaults in production
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Document processing: secrets are supplied locally, never committed
DASHSCOPE_API_KEY=
AI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_RERANK_URL=https://maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
DOCUMENT_PROVIDER=qwen
DOCUMENT_EMBEDDING_MODEL=qwen3.7-text-embedding
DOCUMENT_RERANK_MODEL=qwen3-rerank
DOCUMENT_OCR_MODEL=qwen3.5-ocr
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=xuemian_qwen_text_1024_v1
DOCUMENT_WORKER_LEASE_SECONDS=120
DOCUMENT_PARSE_TIMEOUT_SECONDS=600
DOCUMENT_MODEL_TIMEOUT_SECONDS=60

# Learning quick answer (non-thinking structured output)
LEARNING_ANSWER_MODEL=qwen3.8-flash
LEARNING_MODEL_TIMEOUT_SECONDS=60
LEARNING_REQUEST_TIMEOUT_SECONDS=120

# Learning practice: persistent asynchronous worker
PRACTICE_WORKER_POLL_SECONDS=1
PRACTICE_WORKER_LEASE_SECONDS=30
PRACTICE_WORKER_CONCURRENCY=2
PRACTICE_RUN_TIMEOUT_SECONDS=180
